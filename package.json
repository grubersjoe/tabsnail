{
  "name": "tabsnail",
  "version": "0.1.0",
  "description": "Browser extension to display the tab bar in a snail layout",
  "author": "Jonathan Gruber <gruberjonathan@gmail.com>",
  "private": true,
  "repository": "https://github.com/grubersjoe/tabsnail",
  "bugs": "https://github.com/grubersjoe/tabsnail/issues",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "check": "pnpm exec prettier -c . && pnpm exec tsc && pnpm lint",
    "dev": "wxt",
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "format": "prettier --write .",
    "lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm lint:svelte",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint '{src,public}/**/*.{css,scss}'",
    "lint:svelte": "sv check",
    "postinstall": "wxt prepare",
    "prepare": "husky",
    "zip": "wxt zip",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@tsconfig/svelte": "^5.0.9",
    "@types/bootstrap": "^5.2.11",
    "@wxt-dev/module-svelte": "^2.0.5",
    "bootstrap": "^5.3.9",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "sass-embedded": "^1.108.2",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "sv": "^0.17.1",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "wxt": "^0.21.5"
  }
}
